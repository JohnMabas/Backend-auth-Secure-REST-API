# Server port
PORT=5000

# Secret used to sign & verify JWTs (REQUIRED - the app exits without it)
JWT_SECRET=change_me_to_a_long_random_string

# How long tokens stay valid. Accepts any valid ms/string jsonwebtoken accepts (e.g. "1h", "7d")
JWT_EXPIRES_IN=1h

# development | production
NODE_ENV=development